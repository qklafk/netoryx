---
import { docUrl } from '~/data/site';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<section class="nx-404 not-content">
  <canvas class="net" aria-hidden="true"></canvas>
  <div class="noise" aria-hidden="true"></div>
  <div class="nx-wrap inner">
    <span class="nx-chip">ERROR / 404 / NOT FOUND</span>
    <h1 aria-label="404">
      <span class="blk" data-text="404" aria-hidden="true">404</span>
    </h1>
    <div class="nx-frame msg">
      <p class="ru">Такой страницы нет. Возможно, ссылка устарела или в адресе опечатка.</p>
      <p class="en">This page does not exist. The link may be outdated or the address mistyped.</p>
      <p class="trace" aria-hidden="true">
        <span>$ curl -I {'<'}this page{'>'}</span>
        <span>HTTP/2 404 · route not found · packet dropped</span>
      </p>
    </div>
    <div class="actions">
      <a class="nx-btn primary" href={base}>На главную &rarr;</a>
      <a class="nx-btn" href={docUrl('ru', 'installation')}>Установка</a>
      <a class="nx-btn" href={docUrl('ru', 'faq')}>Вопросы и ответы</a>
      <a class="nx-btn" href={`${base}en/`}>English</a>
    </div>
  </div>
</section>

<script>
  import { initNetwork } from '~/scripts/network';
  const canvas = document.querySelector<HTMLCanvasElement>('.nx-404 .net');
  if (canvas) initNetwork(canvas);
</script>

<style is:global>
  /* this page has its own heading: drop the generic title panel and let the section span the full width */
  main:has(.nx-404) .content-panel:has(h1#_top) {
    display: none;
  }
  main:has(.nx-404) .content-panel,
  main:has(.nx-404) .sl-container {
    padding: 0;
    max-width: none;
  }
  main:has(.nx-404) .content-panel {
    border-top: 0;
  }
</style>

<style>
  .nx-404 {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    min-height: calc(100vh - var(--sl-nav-height, 4rem));
    display: flex;
    align-items: center;
    padding-block: clamp(3rem, 8vw, 6rem);
    background-image: radial-gradient(rgb(var(--nx-rgb) / 0.18) 1px, transparent 1.2px);
    background-size: 22px 22px;
  }
  .net {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    opacity: 0.55;
  }
  .noise {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: repeating-linear-gradient(0deg, rgb(var(--nx-rgb) / 0.04) 0 1px, transparent 1px 3px);
  }
  .inner {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2rem);
    justify-items: start;
  }
  h1 {
    margin: 0;
    border: 0;
    font-family: var(--nx-mono);
    font-weight: 700;
    font-size: clamp(6rem, 26vw, 15rem);
    line-height: 0.9;
    letter-spacing: -0.06em;
  }
  .blk {
    position: relative;
    display: inline-block;
    padding: 0.02em 0.12em 0.06em;
    background: var(--nx-ink);
    color: var(--nx-bg);
  }
  /* a more restless glitch than on the home page: the route is broken, after all */
  .blk::before,
  .blk::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    padding: inherit;
    background: var(--nx-ink);
    color: var(--nx-bg);
    clip-path: inset(0 0 100% 0);
    pointer-events: none;
  }
  .blk::before {
    animation: nx404-a 2.6s steps(1, end) infinite;
  }
  .blk::after {
    animation: nx404-b 3.4s steps(1, end) infinite;
  }
  @keyframes nx404-a {
    0%,
    80%,
    100% {
      clip-path: inset(0 0 100% 0);
      transform: none;
    }
    82% {
      clip-path: inset(10% 0 64% 0);
      transform: translateX(-0.06em);
    }
    85% {
      clip-path: inset(55% 0 18% 0);
      transform: translateX(0.05em);
    }
    88% {
      clip-path: inset(32% 0 44% 0);
      transform: translateX(-0.03em);
    }
    91% {
      clip-path: inset(0 0 100% 0);
    }
  }
  @keyframes nx404-b {
    0%,
    86%,
    100% {
      clip-path: inset(0 0 100% 0);
      transform: none;
    }
    87% {
      clip-path: inset(72% 0 4% 0);
      transform: translateX(0.07em);
    }
    90% {
      clip-path: inset(3% 0 80% 0);
      transform: translateX(-0.05em);
    }
    93% {
      clip-path: inset(0 0 100% 0);
    }
  }
  .msg {
    max-width: 44rem;
    display: grid;
    gap: 0.5rem;
  }
  .msg p {
    margin: 0;
  }
  .ru {
    font-size: 1.125rem;
    color: var(--nx-ink);
  }
  .en {
    color: var(--nx-dim);
    font-size: 0.95rem;
  }
  .trace {
    display: grid;
    gap: 0.15rem;
    margin-top: 0.5rem !important;
    font-family: var(--nx-mono);
    font-size: 0.75rem;
    color: var(--nx-dim);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .blk::before,
    .blk::after {
      animation: none;
      display: none;
    }
  }
</style>
