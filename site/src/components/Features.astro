---
import { features, labels } from '~/data/i18n';
import type { Lang } from '~/data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const data = features[lang];
const l = labels[lang];

// Column spans on the 4-column desktop grid, in the order of the feature list.
const spans = [2, 2, 1, 1, 1, 1, 2, 2];
---

<section class="nx-s not-content" id="features">
  <div class="nx-wrap">
    <div class="nx-head">
      <span class="nx-chip">{l.features}</span>
      <h2>{data.title}</h2>
    </div>
    <div class="nx-grid bento">
      {
        data.items.map((f, i) => (
          <article class="nx-cell item" style={`--span:${spans[i] ?? 1}`}>
            <svg class="art" viewBox="0 0 160 100" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="square">
              {i === 0 && (
                <>
                  <path d="M30 62 L80 82 L130 62 L80 42 Z" />
                  <path d="M30 50 L80 70 L130 50 L80 30 Z" />
                  <path d="M30 38 L80 58 L130 38 L80 18 Z" />
                  <path d="M30 38 V62 M130 38 V62" />
                  <circle cx="60" cy="42" r="1.5" fill="currentColor" />
                  <circle cx="68" cy="46" r="1.5" fill="currentColor" />
                  <circle cx="60" cy="66" r="1.5" fill="currentColor" />
                  <path d="M80 18 V6 M74 10 L80 4 L86 10" />
                </>
              )}
              {i === 1 && (
                <>
                  <rect x="48" y="10" width="64" height="82" />
                  <rect x="56" y="18" width="48" height="22" />
                  <path d="M60 26 H84 M60 32 H72" />
                  {[0, 1, 2].flatMap((r) => [0, 1, 2].map((c) => <circle cx={64 + c * 16} cy={52 + r * 11} r="2" fill="currentColor" />))}
                  <path d="M112 30 H134 M134 22 L142 30 L134 38" />
                  <rect x="12" y="52" width="28" height="18" />
                  <path d="M12 58 H40" />
                </>
              )}
              {i === 2 && (
                <>
                  <circle cx="80" cy="50" r="38" />
                  <ellipse cx="80" cy="50" rx="16" ry="38" />
                  <ellipse cx="80" cy="50" rx="30" ry="38" />
                  <path d="M42 50 H118 M47 32 H113 M47 68 H113" />
                  {[[62, 26], [96, 40], [74, 72], [104, 62], [56, 52]].map(([x, y]) => <rect x={x - 1.5} y={y - 1.5} width="3" height="3" fill="currentColor" />)}
                </>
              )}
              {i === 3 && (
                <>
                  <rect x="56" y="6" width="48" height="88" rx="6" />
                  <path d="M72 12 H88" />
                  <rect x="63" y="22" width="34" height="14" />
                  <rect x="63" y="42" width="34" height="8" />
                  <rect x="63" y="56" width="16" height="16" />
                  <rect x="81" y="56" width="16" height="16" />
                  <path d="M64 82 H96" />
                </>
              )}
              {i === 4 && (
                <>
                  <path d="M20 46 L140 12 L96 90 L74 58 Z" />
                  <path d="M74 58 L140 12 M74 58 L70 80 L84 68" />
                  <path d="M10 70 H34 M4 80 H28 M14 90 H30" stroke-dasharray="2 3" />
                </>
              )}
              {i === 5 && (
                <>
                  <path d="M80 8 L128 24 V52 C128 72 106 86 80 94 C54 86 32 72 32 52 V24 Z" />
                  <circle cx="80" cy="46" r="9" />
                  <path d="M80 55 V70" />
                  <path d="M44 34 H52 M108 34 H116" stroke-dasharray="1 3" />
                </>
              )}
              {i === 6 && (
                <>
                  <rect x="16" y="20" width="84" height="52" />
                  <rect x="30" y="32" width="84" height="52" fill="var(--nx-bg)" />
                  <rect x="44" y="44" width="84" height="46" fill="var(--nx-bg)" />
                  <path d="M54 56 H92 M54 66 H78" />
                  <circle cx="112" cy="68" r="12" />
                  <path d="M112 62 V68 L117 71" />
                </>
              )}
              {i === 7 && (
                <>
                  <rect x="12" y="14" width="136" height="72" />
                  <path d="M12 28 H148" />
                  <circle cx="22" cy="21" r="2" fill="currentColor" />
                  <circle cx="30" cy="21" r="2" fill="currentColor" />
                  <path d="M24 44 L34 52 L24 60" />
                  <path d="M42 62 H80" />
                  <rect x="86" y="58" width="7" height="8" fill="currentColor" />
                </>
              )}
            </svg>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .bento {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .item {
    grid-column: span var(--span);
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: 1.4rem 1.3rem 1.5rem;
    transition: background 0.15s;
  }
  .item:hover {
    background: var(--nx-bg-2);
  }
  .art {
    width: 100%;
    max-width: 11rem;
    height: auto;
    color: var(--nx-ink);
    margin-bottom: 0.8rem;
    align-self: flex-start;
  }
  h3 {
    font-size: 1.1rem;
  }
  p {
    font-size: 0.9375rem;
    color: var(--nx-dim);
    max-width: 52ch;
  }
  @media (max-width: 60rem) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .item {
      grid-column: span 1;
    }
    .item:nth-child(1),
    .item:nth-child(2) {
      grid-column: span 2;
    }
  }
  @media (max-width: 36rem) {
    .bento {
      grid-template-columns: minmax(0, 1fr);
    }
    .item,
    .item:nth-child(1),
    .item:nth-child(2) {
      grid-column: span 1;
    }
  }
</style>
