# Required Telegram bot credential. Keep this file as a template; never commit a real token.
BOT_TOKEN=replace-with-your-bot-token

# Administrator Telegram IDs, comma-separated.
ADMIN_IDS=

# Start with SQLite for a small single-server deployment.
DATABASE_URL=sqlite+aiosqlite:///data/bot.db

# Independent state database for trusted module lifecycle operations.
CORE_STATE_DB=data/core.db

# Set a public HTTPS URL only when using webhooks, Mini App, public subscription links or providers that need it.
PUBLIC_BASE_URL=

# Generate a unique production key and keep it outside version control.
SECRET_KEY=

# shop enables subscription sales; personal supports private use without requiring commercial configuration.
APP_MODE=shop

# Service name and optional logo (https URL, square image) shown to customers in the Mini App header.
# BRAND_NAME=VPN
# BRAND_LOGO_URL=https://example.com/logo.png

# Custom HTTP payment gateway: connect a provider without a built-in integration (see the admin
# "Custom gateway" settings for every field). Webhooks must be HMAC-signed; a status URL is optional.
# CUSTOM_ENABLED=false
# CUSTOM_TITLE=💳 Оплата
# CUSTOM_API_KEY=
# CUSTOM_CREATE_URL=https://pay.example.com/api/invoices
# CUSTOM_HEADERS={"Authorization": "Bearer {api_key}"}
# CUSTOM_BODY_FORMAT=json
# CUSTOM_CREATE_BODY={"order_id": "{payment_id}", "amount": "{amount}", "description": "{description}", "callback": "{callback_url}"}
# CUSTOM_RESPONSE_URL_PATH=data.url
# CUSTOM_RESPONSE_ID_PATH=data.id
# CUSTOM_STATUS_URL=https://pay.example.com/api/invoices/{provider_id}
# CUSTOM_STATUS_PATH=data.status
# CUSTOM_STATUS_VALUES={"paid": "succeeded", "failed": "canceled", "expired": "canceled"}
# CUSTOM_WEBHOOK_SECRET=
# CUSTOM_WEBHOOK_SIGNATURE_HEADER=X-Signature
# CUSTOM_WEBHOOK_HASH=sha256
# CUSTOM_WEBHOOK_SIGNATURE_ENCODING=hex
# CUSTOM_WEBHOOK_ALLOWED_IPS=
# CUSTOM_WEBHOOK_PAYMENT_ID_PATH=order_id
# CUSTOM_WEBHOOK_STATUS_PATH=status

# Tribute (tribute.tg) shop orders. The API key also signs webhooks: set the webhook URL
# <PUBLIC_BASE_URL>/webhooks/tribute in Tribute's API key settings.
# TRIBUTE_ENABLED=false
# TRIBUTE_API_KEY=
# TRIBUTE_SHOP_ID=

# lava.top invoices for a product with a dynamic price. Webhook URL: <PUBLIC_BASE_URL>/webhooks/lavatop,
# authenticated by the X-Api-Key value below (or Basic auth with "login:password").
# LAVATOP_ENABLED=false
# LAVATOP_API_KEY=
# LAVATOP_OFFER_ID=
# LAVATOP_WEBHOOK_SECRET=
# LAVATOP_PAYMENT_METHOD=card
# LAVATOP_EMAIL_DOMAIN=

# Stripe Checkout, charged in STRIPE_CURRENCY at a fixed rate (rubles per 1 unit); the foreign amount is
# rounded up and the wallet receives the original ruble amount. Webhook endpoint: <PUBLIC_BASE_URL>/webhooks/stripe
# with the events checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed and checkout.session.expired.
# STRIPE_ENABLED=false
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_CURRENCY=USD
# STRIPE_RUB_PER_UNIT=

# PayPal (Orders v2), charged in PAYPAL_CURRENCY at a fixed rate. Create a REST app, subscribe a webhook to
# <PUBLIC_BASE_URL>/webhooks/paypal (CHECKOUT.ORDER.APPROVED, PAYMENT.CAPTURE.*) and paste its ID below.
# PAYPAL_ENABLED=false
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# PAYPAL_SANDBOX=false
# PAYPAL_CURRENCY=USD
# PAYPAL_RUB_PER_UNIT=

# WATA acquiring (cards, SBP). Create a terminal access token in the merchant account and point the terminal's
# webhook to <PUBLIC_BASE_URL>/webhooks/wata. The webhook key is downloaded from WATA unless pinned here.
# WATA_ENABLED=false
# WATA_TOKEN=
# WATA_SANDBOX=false
# WATA_PUBLIC_KEY=

# RollyPay (SBP, cards; settled in USDT). The API key and signing secret are issued with the cashier; set the
# cashier's callback_url to <PUBLIC_BASE_URL>/webhooks/rollypay. ROLLYPAY_PAYMENT_METHOD: sbp | card | empty.
# ROLLYPAY_ENABLED=false
# ROLLYPAY_API_KEY=
# ROLLYPAY_SIGNING_SECRET=
# ROLLYPAY_PAYMENT_METHOD=

# cisPay (cards, SBP). Shop UUID and secret key are in the shop settings; set the shop's webhook_url to
# <PUBLIC_BASE_URL>/webhooks/cispay. CISPAY_PAYMENT_METHOD: card | sbp | empty.
# CISPAY_ENABLED=false
# CISPAY_SHOP_ID=
# CISPAY_API_KEY=
# CISPAY_PAYMENT_METHOD=

# TabPay (cards, SBP). The API key (tp_...) and the webhook signing secret are different values; set the shop's
# Webhook URL to <PUBLIC_BASE_URL>/webhooks/tabpay. TABPAY_PAYMENT_METHOD: card | sbp | empty.
# TABPAY_ENABLED=false
# TABPAY_API_KEY=
# TABPAY_WEBHOOK_SECRET=
# TABPAY_PAYMENT_METHOD=

# SeverPay (cards, SBP). Merchant id and secret token of the terminal; set its WEBHOOK_URL to
# <PUBLIC_BASE_URL>/webhooks/severpay. The API needs a customer e-mail; {tg_id} is replaced with the Telegram ID.
# SEVERPAY_ENABLED=false
# SEVERPAY_MID=
# SEVERPAY_TOKEN=
# SEVERPAY_CLIENT_EMAIL={tg_id}@telegram.org

# Cashera (SBP, cards; settled in USD). Enable notifications in the cabinet; the webhook URL
# (<PUBLIC_BASE_URL>/webhooks/cashera) is sent with every invoice. CASHERA_PAYMENT_METHOD: sbp | card | empty.
# CASHERA_ENABLED=false
# CASHERA_API_KEY=
# CASHERA_SECRET=
# CASHERA_PAYMENT_METHOD=

# ParityPay (SBP, cards). Secret key no. 1 is for API access, no. 2 signs webhooks; the webhook URL
# (<PUBLIC_BASE_URL>/webhooks/paritypay) is sent with every invoice. PARITYPAY_SERVICE: sbp | card | empty.
# PARITYPAY_ENABLED=false
# PARITYPAY_SHOP_ID=
# PARITYPAY_SECRET_KEY=
# PARITYPAY_SECRET_KEY2=
# PARITYPAY_SERVICE=

# Aurapay (cards, SBP). Secret key no. 2 signs webhooks; the webhook URL (<PUBLIC_BASE_URL>/webhooks/aurapay)
# is sent with every invoice. AURAPAY_SERVICE: sbp | card | empty.
# AURAPAY_ENABLED=false
# AURAPAY_SHOP_ID=
# AURAPAY_API_KEY=
# AURAPAY_SECRET_KEY2=
# AURAPAY_SERVICE=

# Antilopay acquiring (cards, SBP, SberPay). Set the project's callback URL to <PUBLIC_BASE_URL>/webhooks/antilopay.
# Keys are RSA keys as PEM or bare Base64; a single-line value may use literal \n for line breaks.
# ANTILOPAY_ENABLED=false
# ANTILOPAY_PROJECT_ID=
# ANTILOPAY_SECRET_ID=
# ANTILOPAY_SECRET_KEY=
# ANTILOPAY_CALLBACK_KEY=
# ANTILOPAY_PRODUCT_TYPE=services
# ANTILOPAY_VAT=
# ANTILOPAY_PREFER_METHODS=
# ANTILOPAY_CUSTOMER_EMAIL=
# ANTILOPAY_CHECK_IP=true

# CloudPayments hosted payment page. Set the Check, Pay and Fail notification URLs to
# <PUBLIC_BASE_URL>/webhooks/cloudpayments; notifications are verified with the API secret (Content-HMAC).
# CLOUDPAYMENTS_ENABLED=false
# CLOUDPAYMENTS_PUBLIC_ID=
# CLOUDPAYMENTS_API_SECRET=

# Receipts in "Мой налог" for self-employed sellers (see docs/npd-receipts.md). Log in by SMS from the web admin
# or set the INN and password; the owner is responsible for the receipts being correct.
# NPD_ENABLED=false
# NPD_INN=
# NPD_PASSWORD=
# NPD_PROVIDERS=platega,yookassa,yoomoney,freekassa,robokassa,cloudpayments,wata,antilopay,lavatop,manual
# NPD_SEND_TO_USER=true

# Saved cards for auto-renewal (YooKassa autopayments, CloudPayments tokens). Off by default; each user opts in
# at checkout. The provider must enable recurring payments for the shop first.
# SAVED_CARDS_ENABLED=false

# Direct Toncoin payments to your own wallet, no intermediary. Each invoice has a unique comment; incoming
# transfers are found through toncenter.com (an API key is optional but raises the request limit).
# TON_ENABLED=false
# TON_WALLET_ADDRESS=
# TON_API_KEY=
# TON_API_URL=https://toncenter.com/api/v3
# TON_RATE_RUB=

# Direct USDT (TRC-20) payments to your own TRON address. Each open invoice gets a unique amount (a fraction of a
# cent is added); transfers are found through TronGrid (a free TRON-PRO-API-KEY is recommended).
# USDT_TRC20_ENABLED=false
# USDT_TRC20_ADDRESS=
# USDT_TRC20_API_KEY=
# USDT_TRC20_API_URL=https://api.trongrid.io
# USDT_TRC20_RATE_RUB=

# Exchange rates for the direct crypto payments: fixed *_RATE_RUB values (RUB per coin), or automatic rates from
# CoinGecko cached for CRYPTO_RATE_CACHE_SEC seconds; the fixed rate is the fallback when CoinGecko is unavailable.
# CRYPTO_RATE_AUTO=false
# CRYPTO_RATE_CACHE_SEC=300

# Bot languages users can choose (the default one is always available).
# DEFAULT_LANGUAGE=ru
# ENABLED_LANGUAGES=ru,en,uk,kk,uz,fa,zh

# Web cabinet: the customer area in a regular browser (https://<PUBLIC_BASE_URL>/cabinet) for when Telegram is
# unavailable. Needs an HTTPS PUBLIC_BASE_URL. Login methods: a one-time link from the bot, the Telegram Login
# Widget (set the domain with /setdomain in @BotFather) and an e-mail link (needs SMTP). See docs/web-cabinet.md.
# CABINET_ENABLED=false
# CABINET_LOGIN_BOT=true
# CABINET_LOGIN_TELEGRAM=false
# CABINET_LOGIN_EMAIL=false
# CABINET_SESSION_DAYS=30
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURITY=starttls   # starttls | ssl | none
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=VPN <no-reply@example.com>

# Device limit. The bot counts devices by the x-hwid header that apps such as Happ and v2RayTun send; only a
# keyed hash of it is stored and no client IP addresses are involved. For 3x-ui, "ip" switches back to the panel's
# limitIp, which needs Xray's access log (it records client IPs and visited sites).
# XUI_DEVICE_LIMIT=hwid
# HWID_REQUIRED=false
# HWID_DEVICE_TTL_DAYS=30

# Personal Telegram proxy for users (docs/telegram-proxy.md). TG_PROXY_ACCESS: everyone | subscribers | off.
# SOCKS5 accounts (tg://socks) are served from a password-protected 3x-ui "mixed" inbound that you select in the
# panel settings; open its port in the firewall (it cannot share port 443 with a TLS service). Set the public
# address of a server behind NAT in the panel options: {"tg_socks_host": "...", "tg_socks_port": 1080}.
# TG_PROXY_ACCESS=everyone
# TG_PROXY_MAX_SERVERS=2
# TG_PROXY_ROTATE_COOLDOWN_MIN=60
# TG_SOCKS_ENABLED=true

# YouTube exit (3x-ui servers): send YouTube through a separate exit server in a country where YouTube shows no ads.
# The link is a share link of the exit server: vless:// (Reality or TLS), socks5://user:pass@host:port or ss://.
# Which countries get no ads changes over time, so the method may stop working. When the exit is unreachable,
# YouTube takes the normal route. Add more services to the domain list, e.g. domain:googlevideo.com.
# YOUTUBE_EXIT_ENABLED=false
# YOUTUBE_EXIT_LINK=
# YOUTUBE_EXIT_DOMAINS=geosite:youtube

# --- JSON subscription -------------------------------------------------------------------------------------------
# Happ and v2RayTun receive ready-made Xray configs (with an "Auto" config for 2+ servers); other apps get the link list.
# SUB_JSON_ENABLED=true
# SUB_JSON_AUTO=true
# Russian domains (.ru, .su, .rf, major services) connect directly.
# SUB_JSON_DIRECT_RU=true
# Extra direct domains and domains that must always use the VPN (win over the direct rules); comma separated.
# SUB_JSON_DIRECT_DOMAINS=
# SUB_JSON_PROXY_DOMAINS=
