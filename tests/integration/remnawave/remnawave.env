# Remnawave backend settings for the integration test ONLY (throwaway container, test values).
APP_PORT=3000
METRICS_PORT=3001
API_INSTANCES=1
DATABASE_URL=postgresql://postgres:postgres@remnawave-db:5432/postgres
REDIS_HOST=remnawave-redis
REDIS_PORT=6379
APP_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
IS_TELEGRAM_NOTIFICATIONS_ENABLED=false
PANEL_DOMAIN=panel.example.com
FRONT_END_DOMAIN=*
SUB_PUBLIC_DOMAIN=panel.example.com/api/sub
METRICS_USER=admin
METRICS_PASS=admin
WEBHOOK_ENABLED=true
# WEBHOOK_URL is set in docker-compose.yml (port is configurable).
WEBHOOK_SECRET_HEADER=IntegrationTestWebhookSecret0123456789abcdefghijklmnopqrstuvwxyzAB
SERVICE_SNI_VERIFICATION=false
